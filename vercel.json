{
  "version": 2,
  "crons": [
    {
      "path": "/api/pipeline/check-traffic",
      "schedule": "0 23 * * 0"
    }
  ],
  "builds": [
    { "src": "audit/package.json", "use": "@vercel/next", "config": { "distDir": ".next" } },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "blog/*.html", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/audit/api/$1" },
    { "src": "https://www.kliks.com.au/(.*)", "headers": { "Location": "https://kliks.com.au/$1" }, "status": 301 },
    { "src": "/lukewood", "status": 302, "headers": { "Location": "/" } },
    { "src": "/oh-my-days", "status": 302, "headers": { "Location": "/" } },
    { "src": "/audit/(.*)", "dest": "/$1" },
    { "src": "/blog", "dest": "/blog/index.html" },
    { "src": "/blog/([^/.]+)$", "dest": "/blog/$1.html" },
    { "handle": "filesystem" },
    { "src": "/([^/.]+)$", "dest": "/$1.html" }
  ]
}
