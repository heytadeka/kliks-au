{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "audit/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    { "source": "/lukewood", "destination": "/", "permanent": false },
    { "source": "/oh-my-days", "destination": "/", "permanent": false }
  ]
}
